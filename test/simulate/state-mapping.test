# A mapping entry lives at keccak256(key . slot); simulating a write to one and reading it
# back by key finds the same slot the contract wrote.
# REQUIRES: soldb
# RUN: printf 'break TestContract.sol:74\ncontinue\nprint balances[0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266]\nbreak op SSTORE\ncontinue\nnexti\nprint balances[0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266]\nstorage\nquit\n' | %soldb simulate %{contract_address} "updateBalance(address,uint256)" 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 25 --from 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 --ethdebug-dir %{contract_address}:TestContract:%{ethdebug_dir} --rpc %{rpc_url} -i 2>&1 | FileCheck %s

# Before the write nothing has touched the entry's slot, so its value is unknown rather
# than assumed to be zero.
# CHECK: Breakpoint #1 hit at step {{[0-9]+}}
# CHECK: uint256 balances[0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266] = <unknown: slot [[SLOT:0x[0-9a-f]+]] has not been read or written yet> [slot [[SLOT]]]
# After the `SSTORE` the same slot holds the value that was passed in.
# CHECK: uint256 balances[0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266] = 25 [slot [[SLOT]]]
# CHECK: Storage:
# CHECK: [[SLOT]] = 0x19
