# Profile an automined Anvil transaction through the local REVM replay backend
# REQUIRES: soldb
# RUN: %soldb profile %{test_tx} --backend replay --ethdebug-dir %{contract_address}:TestContract:%{ethdebug_dir} --rpc %{rpc_url} --top 5 2>&1 | FileCheck %s

# CHECK: EVM Gas Profile
# CHECK: Backend: replay
# CHECK: Status: SUCCESS
# CHECK: Transaction gas used:
# CHECK: Program-attributed gas:
# CHECK: Contracts
# CHECK: TestContract (call)
# CHECK: Functions
# CHECK: Hot source lines
# CHECK: Opcodes
# CHECK: Hot instructions

# Functions are named even though this solc emits no ETHDebug function contexts.
# RUN: %soldb profile %{test_tx} --ethdebug-dir %{contract_address}:TestContract:%{ethdebug_dir} --rpc %{rpc_url} --json | jq -r '.functions[].function' | sort | FileCheck %s --check-prefix=FUNCTIONS

# FUNCTIONS-NOT: <anonymous>
# FUNCTIONS: {{^}}increment{{$}}
# FUNCTIONS-NEXT: increment2
# FUNCTIONS-NEXT: increment3
