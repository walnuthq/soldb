# RUN: %soldb profile --trace-file %{project_root}/test/fixtures/profile/trace.json --ethdebug-dir 0x000000000000000000000000000000000000cafe:Counter:%{project_root}/test/fixtures/profile --top 2 --folded %t.folded --flamegraph %t.svg 2>&1 | FileCheck %s
# RUN: test -s %t.folded
