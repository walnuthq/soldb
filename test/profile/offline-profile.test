# RUN: grep -q '<svg' %t.svg
# RUN: %soldb profile --trace-file %{project_root}/test/fixtures/profile/trace.json --ethdebug-dir 0x000000000000000000000000000000000000cafe:Counter:%{project_root}/test/fixtures/profile --json | jq '{stepGas: .totals.stepGas, sourceGas: .totals.sourceGas, unmappedGas: .totals.unmappedGas, function: .functions[0].function}' | FileCheck %s --check-prefix=JSON

