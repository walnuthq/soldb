# `--deploy` traces the constructor itself and stops.
# REQUIRES: soldb
# RUN: %soldb run %{ethdebug_dir}/TestContract.bin --deploy --ethdebug-dir 0x5FbDB2315678afecB367f032d93F642f64180aa3:TestContract:%{ethdebug_dir} --raw --max-steps 6 2>&1 | FileCheck %s

