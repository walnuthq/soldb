# Bad inputs fail with guidance and exit code 2.
# REQUIRES: soldb
# RUN: not %soldb run missing.bin 2>&1 | FileCheck --check-prefix=MISSING %s
# RUN: not %soldb run 0xzz --runtime 2>&1 | FileCheck --check-prefix=MISSING %s
# RUN: not %soldb run %{ethdebug_dir}/TestContract.bin --constructor-args 1 2>&1 | FileCheck --check-prefix=ABI %s
# RUN: not %soldb run 0x60 --runtime --deploy 2>&1 | FileCheck --check-prefix=DEPLOY %s
# RUN: not %soldb run 0x60 --runtime --storage bad 2>&1 | FileCheck --check-prefix=STORAGE %s
# A chain the engine cannot model is refused by name before anything runs.
# RUN: not %soldb run 0x60 --runtime --chain-id 42161 2>&1 | FileCheck --check-prefix=CHAIN %s
# A deployment lands at the CREATE address; `--address` only places `--runtime` code.
# RUN: not %soldb run 0x60 --address 0x0000000000000000000000000000000000000001 2>&1 | FileCheck --check-prefix=ADDRESS %s

# MISSING: is not hex bytecode; pass a `.bin` file or a hex string
# ABI: `--constructor-args` need the contract ABI
# DEPLOY: `--deploy` traces creation code
# STORAGE: invalid `--storage` entry `bad`; expected `<slot>=<value>`
# ADDRESS: --runtime
# CHAIN: the replay backend does not model Arbitrum One (chain id 42161)
# CHAIN: --backend debug-rpc
