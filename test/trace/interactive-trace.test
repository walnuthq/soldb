# Test soldb trace interactive mode
# REQUIRES: soldb
# Trace a transaction in interactive mode and check initial output
# RUN: echo "quit" | %soldb trace %{test_tx} --rpc %{rpc_url} -i 2>&1 | FileCheck %s

# Check for interactive debugger startup: what was loaded, then one line for the
# initial stop with the step, program counter, opcode, and gas.
# CHECK: Loaded trace with {{[0-9]+}} steps.
# CHECK: step 0/{{[0-9]+}}, pc {{[0-9]+}}, {{[A-Z0-9]+}}, gas {{[0-9]+}}
# The prompt is not echoed when commands are piped in.
# CHECK-NOT: soldb>


