# Test tracing of increment function call with solc 0.8.31 (ETHDebug format)
# REQUIRES: soldb
# This test uses ETHDebug format (solc 0.8.31+) which shows nested internal function calls
# RUN: command -v solc-select >/dev/null 2>&1 && solc-select use 0.8.31 >/dev/null 2>&1 || true && \
# RUN: cd %S/../examples && rm -rf out && %S/deploy-contract.sh --solc=solc --rpc=%{rpc_url} TestContract TestContract.sol --debug-dir=out >/dev/null 2>&1 && CONTRACT_ADDR=$(cat out/deployment.json | jq -r '.address') && TX=$(DEBUG_DIR=out RPC_URL=%{rpc_url} %S/interact-contract.sh send "increment(uint256)" 4 2>&1 | grep -o '0x[a-fA-F0-9]\{64\}' | head -1) && %soldb trace $TX --ethdebug-dir $CONTRACT_ADDR:TestContract:%S/../examples/out --rpc %{rpc_url} 2>&1 | FileCheck %s

# Check for the specific function calls we expect
# CHECK: Loading transaction
# CHECK: Contract: TestContract

# Check for the call hierarchy with increment function
# CHECK: #0 TestContract::runtime_dispatcher
# CHECK: #1 increment(uint256 amount = 4) at TestContract.sol:23

# Check for nested function calls
# CHECK: increment2(uint256 amount) [internal] at TestContract.sol:39
# CHECK: raw entry stack:
# CHECK: increment3(uint256 amount, uint256 amount2) [internal] at TestContract.sol:54
# CHECK: raw entry stack:

# Check decoded event artifacts are included in the human trace
# CHECK: emit TestContract::CounterIncremented(newValue = 13)
