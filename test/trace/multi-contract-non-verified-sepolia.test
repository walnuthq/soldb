# The same OP Sepolia transaction traced live with no debug info: every call is its
# address and the selector it was called with.
# REQUIRES: soldb, sepolia-rpc
# RUN: %soldb trace 0x1362ee26050935178c2f491dbe2a5f0d277903cb5d77fa9e6e30d8b2db31a541 --rpc %{sepolia_rpc_url} | FileCheck %s

# CHECK: Status: SUCCESS
# CHECK: Call Stack:
# CHECK: #0 0x59a714559b46c823d87986b5c5b7c630e2f5668d::runtime_dispatcher
# CHECK-NEXT:   #1 0xdcdd1dd0ff17043f8bcd1ac9e5be20bbed4fac0a::0x41304fac
# CHECK-NEXT:   #2 0x6a85ebf0eba5307943bdf27d02d198bc64e9ffed::0x55ec8a03
# CHECK-NEXT:     ← return 0x{{0+}}50
