# CHECK-NEXT:   #2 TaxCalculator::calculateTax(uint256 value = 1000, string orderType = physical)
# CHECK-NEXT:     #3 getBaseRate(string orderType) [internal]
# CHECK:       ← return (uint256 = 8)
# CHECK-NEXT:     ← return (uint256 = 80)
# CHECK:   #5 ShippingManager::initiateShipping(address customer = 0x286af310ea3303c80ebe9a66f6998b21bd8c1c29, string method = express)
# CHECK:   #8 PaymentProcessor::processPayment(address from = 0x286af310ea3303c80ebe9a66f6998b21bd8c1c29, uint256 amount = 1080)
